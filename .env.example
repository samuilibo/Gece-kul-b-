# Copy to .env and fill in. This file is read ONLY by the Node.js server; nothing here reaches the browser.

# HTTP port and bind address. Keep 127.0.0.1 unless you really need LAN access.
PORT=3000
HOST=127.0.0.1

# Optional password for the admin panel (open /admin?token=... once; the browser remembers it).
# Strongly recommended if HOST is not 127.0.0.1.
ADMIN_TOKEN=

# --- YouTube (one of the two is required for a real stream; demo mode needs neither) ---
# A) API key: Google Cloud Console -> APIs & Services -> enable "YouTube Data API v3" -> Credentials -> API key.
#    Restrict the key to the YouTube Data API v3.
YOUTUBE_API_KEY=

# B) OAuth (use this if the key-only setup is refused for your stream / for streamList).
#    Create an OAuth client (Desktop app), scope https://www.googleapis.com/auth/youtube.readonly,
#    and obtain a refresh token (see README -> "OAuth").
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=

# 1 = try liveChatMessages.streamList (gRPC, low latency) first and fall back to polling.
# 0 = always use liveChatMessages.list polling.
YOUTUBE_USE_GRPC=1

# --- Twitch (official EventSub WebSocket; no public URL needed) ---
# dev.twitch.tv/console -> Register Your Application -> Client Type: Public, OAuth Redirect URL: http://localhost
# Only the client id is needed; you log in from the admin panel ("Log in with Twitch", device code).
TWITCH_CLIENT_ID=

# --- Kick (official Kick Public API, webhooks) ---
# kick.com/settings/developer -> create app (2FA required) -> enable webhooks, Webhook URL = https://<your-tunnel>/webhooks/kick
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Local port of the webhook-only listener. Point your tunnel (e.g. cloudflared) at this port, NOT at PORT.
KICK_WEBHOOK_PORT=3001
KICK_WEBHOOK_HOST=127.0.0.1

# --- TikTok (UNOFFICIAL, opt-in in the admin panel) ---
# Optional API key for the Euler Stream signing service used by tiktok-live-connector (https://www.eulerstream.com).
TIKTOK_SIGN_API_KEY=

# Viewers who have not chatted for this many minutes leave the club automatically (0 = never).
IDLE_MINUTES=60

# Extra words to filter (comma separated), added to the built-in TR/EN list.
BAD_WORDS=

# Folder with YOUR licensed MP3 / WAV / OGG / M4A / FLAC / OPUS files (sub-folders = genre names).
MUSIC_DIR=music

# SQLite database file.
DB_FILE=data/neonclub.sqlite
