{
  "name": "neon-club-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interactive 3D nightclub for YouTube, Twitch, Kick and TikTok live streams (Three.js + Node.js)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --import tsx server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node tools/smoke.mjs",
    "benchmark": "node tools/benchmark.mjs",
    "assets": "python3 tools/build_characters.py",
    "enable-tiktok": "npm install --no-save tiktok-live-connector@2.5.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "dotenv": "^18.0.10",
    "three": "^0.187.0",
    "tsx": "^4.23.15",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/samuilibo/neon-club-live.git"
  },
  "homepage": "https://github.com/samuilibo/neon-club-live#readme",
  "bugs": {
    "url": "https://github.com/samuilibo/neon-club-live/issues"
  },
  "keywords": [
    "threejs",
    "webgl",
    "live-stream",
    "youtube-live",
    "twitch",
    "kick",
    "tiktok-live",
    "obs",
    "nightclub",
    "interactive-stream",
    "chat-game"
  ]
}
